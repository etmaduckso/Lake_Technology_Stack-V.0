generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(uuid())
  walletAddress String   @unique
  nickname      String?
  createdAt     DateTime @default(now())
  credits       Int      @default(5)
  role          String   @default("USER")

  // ── Soft-Delete (Auditoria Permanente) ──────────────────────────────────
  // Nunca apagar um usuário fisicamente. isDeleted = true o torna inativo;
  // deletedAt registra o timestamp para audit trail e compliance LGPD.
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  // ── Relações ─────────────────────────────────────────────────────────────
  assets               Asset[]
  investments          InvestmentReceipt[]
  actions              AuditLog[]
  credit_ledger        credit_ledger[]
  kycRecord            KycRecord?
  payment_orders       payment_orders[]
  user_credits         user_credits?
  medals               UserMedal[]
  userProfile          UserProfile?
  adminPermission      AdminPermission?
  riskAcknowledgements RiskAcknowledgement[]

  @@index([isDeleted])
  @@map("users")
}

model UserMedal {
  id         String   @id @default(uuid())
  userWallet String
  medalId    String
  earnedAt   DateTime @default(now())
  user       User     @relation(fields: [userWallet], references: [walletAddress], onDelete: Cascade)

  @@unique([userWallet, medalId])
  @@index([userWallet])
  @@map("user_medals")
}

model AdminWhitelist {
  walletAddress String   @id @unique
  addedAt       DateTime @default(now())
  addedBy       String?
  role          String   @default("SUPER_ADMIN")

  @@map("admins")
}

model Asset {
  id                   String                @id @default(uuid())
  ownerWallet          String
  name                 String
  type                 String
  valuation            Decimal               @db.Decimal(20, 2)
  tokenPrice           Decimal               @db.Decimal(20, 2)
  totalTokens          Int
  imageUrl             String?
  contractUrl          String?
  status               AssetStatus           @default(DRAFT)
  contractAddress      String?
  isListed             Boolean               @default(true)
  chainId              Int?
  sector               String?
  tokenNature          String?
  treasuryTokens       Int                   @default(0)
  marketTokens         Int                   @default(0)
  tokensAvailable      Int                   @default(0)
  royalties            Float                 @default(0.0)
  description          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  owner                User                  @relation(fields: [ownerWallet], references: [walletAddress])
  investments          InvestmentReceipt[]
  riskAcknowledgements RiskAcknowledgement[]

  @@map("assets")
}

model KycRecord {
  id            String    @id @default(uuid())
  userWallet    String    @unique
  status        KycStatus @default(PENDING)
  encryptedData String
  verifiedAt    DateTime?
  reviewedBy    String?
  user          User      @relation(fields: [userWallet], references: [walletAddress])

  @@map("kyc_records")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorWallet String
  actionType  String
  targetId    String?
  details     String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [actorWallet], references: [walletAddress])

  @@map("audit_logs")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model credit_ledger {
  id               String          @id @default(uuid())
  user_id          String
  operation_type   OperationType
  amount           Int
  balance_before   Int
  balance_after    Int
  crypto_amount    Decimal?        @db.Decimal(30, 18)
  crypto_symbol    String?         @db.VarChar(20)
  tx_hash          String?         @db.VarChar(255)
  related_order_id String?
  description      String?
  metadata         Json?
  created_at       DateTime        @default(now())
  payment_orders   payment_orders? @relation(fields: [related_order_id], references: [id])
  users            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([created_at])
  @@index([operation_type])
  @@index([related_order_id])
  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payment_orders {
  id                     String          @id
  user_id                String
  external_tid           BigInt          @unique
  amount_brl             Decimal         @db.Decimal(20, 2)
  amount_crypto          Decimal         @db.Decimal(30, 18)
  currency_symbol        String          @db.VarChar(20)
  status                 PaymentStatus   @default(PENDING)
  smart_contract_address String?         @db.VarChar(255)
  blockchain_network     String?         @db.VarChar(50)
  created_at             DateTime        @default(now())
  updated_at             DateTime
  credit_ledger          credit_ledger[]
  users                  User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  webhook_logs           webhook_logs[]

  @@index([created_at])
  @@index([status])
  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model user_credits {
  user_id      String   @id
  balance      Int      @default(0)
  last_updated DateTime @default(now())
  users        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model webhook_logs {
  id               String          @id
  event_type       String?         @db.VarChar(50)
  payload          Json
  token_received   String?         @db.VarChar(255)
  external_tid     BigInt?
  related_order_id String?
  ip_address       String?         @db.Inet
  user_agent       String?
  processed        Boolean         @default(false)
  created_at       DateTime        @default(now())
  payment_orders   payment_orders? @relation(fields: [related_order_id], references: [id])

  @@index([created_at])
  @@index([external_tid])
  @@index([processed])
}

enum AssetStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  TOKENIZED
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum OperationType {
  DEPOSIT
  USAGE
  REFUND
  ADJUSTMENT
  MINT_FEE
  INVESTMENT_FEE
  SECONDARY_MARKET_FEE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model InvestmentReceipt {
  id                  String   @id @default(uuid())
  investorWallet      String
  assetId             String
  quantity            Int
  amountPaidCrypto    Decimal  @db.Decimal(30, 18)
  cryptoSymbol        String   @default("SOL")
  txHash              String
  child_fraction_hash String   @unique
  status              String   @default("HELD")
  resalePrice         Decimal? @db.Decimal(20, 2)
  createdAt           DateTime @default(now())

  investor User  @relation(fields: [investorWallet], references: [walletAddress])
  asset    Asset @relation(fields: [assetId], references: [id])

  @@index([investorWallet])
  @@index([assetId])
  // ── P0: índice em status para queries do Mercado Secundário (evita Full Scan)
  @@index([status])
  @@map("investment_receipts")
}

/// Aceite de Ciência de Risco — CVM 175 e regulação de securities.
/// Deve ser criado ANTES de qualquer investimento em ativos classificados
/// como valores mobiliários. Imutável após criação (nunca atualizar, nunca deletar).
model RiskAcknowledgement {
  id String @id @default(uuid())

  // Partes da operação
  userWallet String
  assetId    String

  // Evidência de aceite
  acceptedAt    DateTime @default(now())
  ipAddress     String? // IP do cliente no momento do aceite (cabeçalho X-Forwarded-For)
  signatureHash String // Hash da tx Solana que comprova a intenção on-chain

  // Relações
  user  User  @relation(fields: [userWallet], references: [walletAddress])
  asset Asset @relation(fields: [assetId], references: [id])

  @@index([userWallet])
  @@index([assetId])
  @@index([acceptedAt])
  @@map("risk_acknowledgements")
}

model AdminPermission {
  id              String   @id @default(uuid())
  walletAddress   String   @unique
  role            String
  grantedByMaster String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [walletAddress], references: [walletAddress])

  @@map("admin_permissions")
}

model UserProfile {
  id                  String    @id @default(uuid())
  walletAddress       String    @unique
  isCitizen           Boolean   @default(false)
  citizenshipMintDate DateTime?
  sbtImageUrl         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [walletAddress], references: [walletAddress])

  @@map("user_profiles")
}
